# Maintainer: HandShaker for Linux Contributors
pkgname=handshaker-linux
pkgver=0.1.0
pkgrel=1
pkgdesc="Open-source Linux client, CLI, and FUSE mount for the Smartisan HandShaker Android protocol"
arch=('x86_64' 'aarch64')
url="https://github.com/Plus2z/HandShaker_for_Linux"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'gst-plugins-good' 'libusb' 'fuse3' 'hicolor-icon-theme')
makedepends=('cargo' 'nodejs' 'pnpm' 'pkgconf')
optdepends=(
  'gst-libav: additional hardware/software video codecs for embedded playback'
  'p7zip: extract optional assets from local official .dmg/.exe installers'
)

# Local source checkout build helper: run `makepkg -ei` inside a temporary copy
# or set SRC_ROOT=/path/to/Handshaker_for_Linux before calling makepkg.
_src_root() {
  if [[ -n "${HANDSHAKER_SRC_ROOT:-}" ]]; then
    printf '%s\n' "${HANDSHAKER_SRC_ROOT}"
  else
    realpath "${startdir}/../.."
  fi
}

build() {
  local root
  root="$(_src_root)"
  cd "${root}"

  pnpm install --frozen-lockfile
  pnpm run build
  cargo build --release --locked --workspace --features handshaker-desktop/custom-protocol
}

check() {
  local root
  root="$(_src_root)"
  cd "${root}"

  cargo test --release --locked --workspace
  pnpm run test
}

package() {
  local root
  root="$(_src_root)"
  cd "${root}"

  install -Dm755 "target/release/handshaker-desktop" "${pkgdir}/usr/bin/handshaker-desktop"
  install -Dm755 "target/release/hs-cli" "${pkgdir}/usr/bin/hs-cli"
  install -Dm755 "target/release/handshaker-mount" "${pkgdir}/usr/bin/handshaker-mount"
  install -Dm755 "packaging/handshaker-linux.sh" "${pkgdir}/usr/bin/handshaker-linux"

  install -Dm644 "packaging/handshaker-linux.desktop" \
    "${pkgdir}/usr/share/applications/handshaker-linux.desktop"
  install -Dm644 "packaging/io.handshaker.linux.metainfo.xml" \
    "${pkgdir}/usr/share/metainfo/io.handshaker.linux.metainfo.xml"
  install -Dm644 "packaging/udev/70-handshaker.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/70-handshaker.rules"

  install -Dm644 "src-tauri/icons/32x32.png" \
    "${pkgdir}/usr/share/icons/hicolor/32x32/apps/handshaker-linux.png"
  install -Dm644 "src-tauri/icons/128x128.png" \
    "${pkgdir}/usr/share/icons/hicolor/128x128/apps/handshaker-linux.png"
  install -Dm644 "src-tauri/icons/icon.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/handshaker-linux.png"

  install -Dm755 "tools/extract_assets.py" \
    "${pkgdir}/usr/share/handshaker-linux/tools/extract_assets.py"
}
